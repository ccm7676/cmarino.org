---
import '@fontsource/maname/400.css';
import '@fontsource/space-grotesk/700.css';
import '../styles/global.css';

interface Props {
  title: string;
  background: string;
  /** Figma frame height in px (frames are 3690px wide), or 'auto' to fit content. */
  height?: number | 'auto';
}

const { title, background, height = 2766 } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <script is:inline>
      // Tag cross-page view transitions that change section (e.g. /projects -> /photos)
      // so the nav underline only redraws then, not for /photos -> /photos/gallery.
      addEventListener('pagereveal', (event) => {
        if (!event.viewTransition) return;
        const from = window.navigation?.activation?.from?.url || document.referrer;
        if (!from) return;
        const section = (url) => new URL(url).pathname.split('/')[1];
        if (section(from) !== section(location.href)) {
          event.viewTransition.types.add('section-change');
        }
      });
    </script>
  </head>
  <body style={`--frame-bg: ${background}; --frame-h: ${height === 'auto' ? 0 : height};`}>
    <main class:list={['frame', { auto: height === 'auto' }]}>
      <slot />
    </main>
  </body>
</html>
