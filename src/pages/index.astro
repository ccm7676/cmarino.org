---
import { Image } from 'astro:assets';
import Frame from '../layouts/Frame.astro';
import PaperTexture from '../components/PaperTexture.astro';
import Copyright from '../components/Copyright.astro';
import photo from '../assets/contact-photo.webp';
import arrow from '../assets/arrow.svg';

const links = [
  { label: 'LINKEDIN', href: 'https://linkedin.com/in/ccm7676', external: true },
  { label: 'GITHUB', href: 'https://github.com/ccm7676', external: true },
  { label: 'EMAIL', href: 'mailto:carl@ccm.me', external: false },
];
---

<Frame title="Carl Marino — Contact" background="black" height={2792}>
  <div class="photo">
    <Image
      src={photo}
      alt=""
      widths={[480, 800, 1200, 1600, 2400]}
      sizes="(max-width: 1000px) 100vw, (orientation: portrait) 100vw, 47vw"
      priority
    />
  </div>

  <ul class="links">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
    <li>
      <a href="/portfolio">
        {'WORK '}
        <span class="arrow">
          <span class="arrow-rotate">
            <img src={arrow.src} alt="" />
          </span>
        </span>
      </a>
    </li>
  </ul>

  <PaperTexture
    x={1813.02}
    y={0}
    width={1902.583}
    height={2766.162}
    crop={{ left: 0.25, top: -0.08, width: 217.97, height: 99.99 }}
  />

  <Copyright year={2025} centerX={3389.83} color="white" />
</Frame>

<style>
  .photo {
    position: absolute;
    left: calc(77.82 * var(--ux));
    top: calc(81.89 * var(--uy));
    width: calc(1727.203 * var(--ux));
    height: calc(2598.383 * var(--uy));
    border: calc(10 * var(--u)) solid black;
    border-radius: calc(70 * var(--u));
    overflow: hidden;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom;
  }

  .links {
    position: absolute;
    left: calc(2075.61 * var(--ux));
    top: calc(361.59 * var(--uy));
    display: flex;
    flex-direction: column;
    gap: calc(55.47 * var(--u));
    font-family: 'Charlottenburg Classic', serif;
    font-size: calc(350 * var(--u));
    line-height: calc(438 * var(--u));
    color: white;
    white-space: pre;
  }

  /* Positioned against the link list (in --u so it stays beside the WORK text). */
  .arrow {
    position: absolute;
    left: calc((3157.53 - 2075.61) * var(--u));
    top: calc((1942.83 - 361.59) * var(--u));
    width: calc(232.169 * var(--u));
    height: calc(232.169 * var(--u));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .arrow-rotate {
    position: relative;
    flex: none;
    width: calc(164.17 * var(--u));
    height: calc(164.17 * var(--u));
    transform: rotate(45deg);
  }

  .arrow img {
    position: absolute;
    top: -9.14%;
    left: -1.87%;
    width: 111.01%;
    height: 109.67%;
    max-width: none;
  }

  /* Portrait: stacked on one screen, the photo takes whatever height the links leave. */
  @media (orientation: portrait) {
    .photo {
      position: relative;
      inset: auto;
      flex: 1 1 0;
      width: 100%;
      height: auto;
      min-height: 6rem;
      border: 0;
      border-radius: clamp(1rem, 4cqw, 2rem);
    }

    .links {
      position: relative;
      inset: auto;
      gap: 0;
      font-size: clamp(1.75rem, min(11cqw, 8svh), 5rem);
      line-height: 1.15;
    }

    .arrow {
      position: relative;
      inset: auto;
      display: inline-flex;
      width: 0.6em;
      height: 0.6em;
      vertical-align: -0.02em;
    }

    .arrow-rotate {
      width: 0.42em;
      height: 0.42em;
    }
  }
</style>
