---
import { Image } from 'astro:assets';
import Frame from '../layouts/Frame.astro';
import PaperTexture from '../components/PaperTexture.astro';
import Copyright from '../components/Copyright.astro';
import photo from '../assets/menu-photo.webp';

const links = [
  { label: 'CONTACT', href: '/' },
  { label: 'PROJECTS', href: '/projects' },
  // Music page isn't built yet.
  { label: 'MUSIC', href: undefined },
  { label: 'PHOTOS ', href: '/photos' },
];
---

<Frame title="Carl Marino — Portfolio" background="#e2e0dd">
  <Copyright year={2026} centerX={284.78} color="black" />

  <ul class="links">
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>

  <PaperTexture
    x={-28.38}
    y={1.6}
    width={4024.531}
    height={2764.56}
    crop={{ left: 0.12, top: -0.08, width: 102.98, height: 99.99 }}
  />

  <div class="photo">
    <Image src={photo} alt="" widths={[480, 800, 1200, 1600, 2400]} sizes="47vw" />
  </div>
</Frame>

<style>
  .links {
    position: absolute;
    left: calc(1997.61 * var(--u));
    top: calc(361.59 * var(--u));
    display: flex;
    flex-direction: column;
    gap: calc(55.47 * var(--u));
    font-family: 'Charlottenburg Classic', serif;
    font-size: calc(350 * var(--u));
    line-height: calc(438 * var(--u));
    color: black;
    white-space: pre;
  }

  .photo {
    position: absolute;
    left: calc(74.37 * var(--u));
    top: calc(95.13 * var(--u));
    width: calc(1706.2 * var(--u));
    height: calc(2564.622 * var(--u));
    border-radius: calc(70 * var(--u));
    overflow: hidden;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
