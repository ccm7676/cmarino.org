---
import { Image } from 'astro:assets';
import Frame from '../layouts/Frame.astro';
import PaperTexture from '../components/PaperTexture.astro';
import Copyright from '../components/Copyright.astro';
import photo from '../assets/menu-photo.webp';

const links = [
  { label: 'CONTACT', href: '/' },
  { label: 'PROJECTS', href: '/projects' },
  // Music page isn't built yet.
  { label: 'MUSIC', href: undefined },
  { label: 'PHOTOS ', href: '/photos' },
];
---

<Frame title="Carl Marino — Portfolio" background="#e2e0dd">
  <Copyright year={2026} centerX={284.78} color="black" />

  <ul class="links">
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>

  <PaperTexture
    x={-28.38}
    y={1.6}
    width={4024.531}
    height={2764.56}
    crop={{ left: 0.12, top: -0.08, width: 102.98, height: 99.99 }}
  />

  <div class="photo">
    <Image
      src={photo}
      alt=""
      widths={[480, 800, 1200, 1600, 2400]}
      sizes="(max-width: 1000px) 100vw, (orientation: portrait) 100vw, 47vw"
      priority
    />
  </div>
</Frame>

<style>
  .links {
    position: absolute;
    left: calc(1997.61 * var(--ux));
    top: calc(361.59 * var(--uy));
    display: flex;
    flex-direction: column;
    gap: calc(55.47 * var(--u));
    font-family: 'Charlottenburg Classic', serif;
    font-size: calc(350 * var(--u));
    line-height: calc(438 * var(--u));
    color: black;
    white-space: pre;
  }

  .photo {
    position: absolute;
    left: calc(74.37 * var(--ux));
    top: calc(95.13 * var(--uy));
    width: calc(1706.2 * var(--ux));
    height: calc(2564.622 * var(--uy));
    border-radius: calc(70 * var(--u));
    overflow: hidden;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Portrait: stacked on one screen, the photo takes whatever height the links leave. */
  @media (orientation: portrait) {
    .links {
      position: relative;
      inset: auto;
      gap: 0;
      font-size: clamp(1.75rem, min(11cqw, 8svh), 5rem);
      line-height: 1.15;
    }

    /* First on the page, and kept above the paper texture as on the design. */
    .photo {
      position: relative;
      inset: auto;
      z-index: 1;
      order: -1;
      flex: 1 1 0;
      width: 100%;
      height: auto;
      min-height: 6rem;
      border-radius: clamp(1rem, 4cqw, 2rem);
    }
  }
</style>
