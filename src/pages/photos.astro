---
import { Image } from 'astro:assets';
import Frame from '../layouts/Frame.astro';
import PaperTexture from '../components/PaperTexture.astro';
import Copyright from '../components/Copyright.astro';
import SiteNav from '../components/SiteNav.astro';
import photo from '../assets/photos/island-sunset.webp';
import underline from '../assets/underline-photos.svg';

const panels = [163.44, 1336.24, 2476.45];
---

<Frame title="Carl Marino — Photos" background="#353d4d">
  <Copyright year={2026} centerX={284.78} color="black" />

  {
    panels.map((x, i) => (
      <div
        class="panel"
        style={`--x: ${x}; --col: ${i + 1}; view-transition-name: photo-panel-${i}; view-transition-class: wipe wipe-${i + 1};`}
      >
        <Image src={photo} alt="" widths={[400, 800, 1200, 1600]} sizes="29vw" priority />
      </div>
    ))
  }

  <h1>PHOTOS</h1>

  <SiteNav active="photos" underline={{ src: underline.src, x: -1.27, y: 117.01, width: 444.033 }} />

  <PaperTexture x={0} y={0} width={3742.732} height={2801.338} />

  <a class="view" href="/photos/gallery">VIEW</a>
</Frame>

<style>
  .panel {
    position: absolute;
    left: calc(var(--x) * var(--ux));
    top: calc(712.43 * var(--uy));
    width: calc(1050.108 * var(--ux));
    height: calc(1574.97 * var(--uy));
  }

  .panel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    position: absolute;
    left: calc(1870.76 * var(--ux));
    top: calc(1124.92 * var(--uy));
    transform: translateX(-50%);
    font-family: 'Charlottenburg Choices', serif;
    font-size: calc(600 * var(--u));
    line-height: normal;
    white-space: nowrap;
    color: #2b313d;
    view-transition-name: photos-title;
    view-transition-class: wipe wipe-2;
  }

  .view {
    position: absolute;
    left: calc(1388.98 * var(--ux));
    top: calc(2048.56 * var(--uy));
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(964.777 * var(--ux));
    height: calc(200 * var(--u));
    border: calc(8 * var(--u)) solid white;
    font-family: 'Unity Sans Basic', sans-serif;
    font-size: calc(80 * var(--u));
    line-height: normal;
    color: white;
    view-transition-name: photos-view;
    view-transition-class: wipe wipe-3 above-paper;
  }

  /* Small screens: the three panels fill the screen under the nav, title and button on top. */
  @media (max-width: 1000px), (orientation: portrait) {
    :global(.frame) {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto minmax(24rem, 1fr) auto;
      column-gap: clamp(0.5rem, 2.5cqw, 1.25rem);
    }

    :global(.frame > *) {
      grid-column: 1 / -1;
    }

    .panel {
      position: relative;
      inset: auto;
      grid-row: 2;
      grid-column: var(--col);
      width: auto;
      height: auto;
    }

    h1 {
      position: relative;
      inset: auto;
      grid-row: 2;
      align-self: center;
      justify-self: center;
      transform: none;
      font-size: clamp(3rem, 17cqw, 9rem);
    }

    .view {
      position: relative;
      inset: auto;
      z-index: 1;
      grid-row: 2;
      align-self: end;
      justify-self: center;
      width: min(70%, 22rem);
      height: auto;
      margin-bottom: 12%;
      padding: 0.9em;
      border-width: 2px;
      font-size: clamp(0.85rem, 3.3cqw, 1.125rem);
    }
  }
</style>
