---
import Frame from '../layouts/Frame.astro';
import PaperTexture from '../components/PaperTexture.astro';
import Copyright from '../components/Copyright.astro';
import SiteNav from '../components/SiteNav.astro';
import underline from '../assets/underline-projects.svg';

const projects = [
  {
    name: 'EASEL',
    // TODO: Easel has no description yet; this is the design's placeholder text.
    description:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nam quis tincidunt nibh. Integer sed fringilla sem, et consectetur orci. Etiam ut lorem turpis. Praesent id dignissim felis. Proin commodo molestie lorem, at varius massa rhoncus eget. Curabitur nec nisi venenatis, viverra est at, blandit diam. Mauris at commodo nunc. Nunc vitae sapien non magna fringilla interdum sit amet aliquet velit. Phasellus malesuada viverra quam, a pulvinar massa tincidunt ac. Nullam posuere dictum ante at fringilla. Fusce tempus quam eget ultricies semper. Morbi rutrum convallis turpis vitae lacinia. Aenean volutpat justo lorem, quis ornare massa dapibus vel.',
    href: 'https://github.com/ccm7676/Easel',
    x: 144.25,
  },
  {
    name: 'MORSY',
    description:
      "Morsy is an open-source private messenger. Many private messengers nowadays have one major fault, which is the centralized nature of the servers which the messages are sent through. Morsy's primary aim is to provide privacy to its users while requiring zero trust in the servers. This is achieved by using WebRTC to send the messages directly between users, making the server's sole purpose to provide the initial connection.",
    href: 'https://github.com/MorsyApp/Morsy',
    x: 1338.92,
  },
  {
    name: 'SUDOKUH',
    description:
      "SudoKuh is a Sudoku app written in Python. Unlike many other Sudoku apps, SudoKuh doesn't have preprogrammed puzzles, instead it generates puzzles using a custom algorithm with varying levels of difficulty.",
    href: 'https://github.com/ccm7676/sudokuh',
    x: 2533.59,
  },
];
---

<Frame title="Carl Marino — Projects" background="#898d7f">
  <Copyright year={2026} centerX={284.78} color="black" />

  <h1>PROJECTS</h1>

  {
    projects.map((project, i) => (
      <article
        style={`--x: ${project.x}; view-transition-name: project-${i}; view-transition-class: wipe wipe-${i + 2};`}
      >
        <h2>{project.name}</h2>
        <p>{project.description}</p>
        <a class="view" href={project.href} target="_blank" rel="noopener">
          VIEW
        </a>
      </article>
    ))
  }

  <SiteNav active="projects" underline={{ src: underline.src, x: -7.47, y: 126.77, width: 553.993 }} />

  <PaperTexture x={0} y={0} width={3742.732} height={2801.338} />
</Frame>

<style>
  h1 {
    position: absolute;
    left: calc(1844.68 * var(--ux));
    top: calc(404.36 * var(--uy));
    transform: translateX(-50%);
    font-family: 'Charlottenburg Classic', serif;
    font-size: calc(600 * var(--u));
    line-height: normal;
    white-space: nowrap;
    color: rgba(0, 0, 0, 0.4);
    view-transition-name: projects-title;
    view-transition-class: wipe;
  }

  article {
    position: absolute;
    left: calc(var(--x) * var(--ux));
    top: calc(1230.12 * var(--uy));
    width: calc(1064.887 * var(--ux));
    height: calc(1285.306 * var(--uy));
    padding: calc(55.4 * var(--u)) 0 0 calc(78.08 * var(--u));
    border-radius: calc(50 * var(--u));
    background: #696d61;
    box-shadow: inset calc(4 * var(--u)) calc(4 * var(--u)) calc(4 * var(--u)) calc(8 * var(--u))
      rgba(38, 38, 38, 0.25);
    color: white;
  }

  h2 {
    font-family: 'Charlottenburg Classic', serif;
    font-size: calc(100 * var(--u));
    line-height: normal;
    white-space: nowrap;
  }

  article p {
    position: absolute;
    left: calc(78.08 * var(--u));
    top: calc(200.23 * var(--u));
    right: calc(79.21 * var(--u));
    font-family: 'Unity Sans Basic', sans-serif;
    font-size: calc(40 * var(--u));
    line-height: normal;
    text-align: justify;
    text-transform: capitalize;
  }

  .view {
    position: absolute;
    right: calc(40.08 * var(--u));
    bottom: calc(51.08 * var(--u));
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(484.084 * var(--u));
    height: calc(160 * var(--u));
    border-radius: calc(2000 * var(--u));
    background: white;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: calc(64 * var(--u));
    line-height: normal;
    color: #696d61;
  }

  @media (max-width: 1000px), (orientation: portrait) {
    h1 {
      position: relative;
      inset: auto;
      transform: none;
      font-size: clamp(2.75rem, 13cqw, 6.5rem);
    }

    article {
      position: relative;
      inset: auto;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      width: auto;
      height: auto;
      padding: clamp(1.25rem, 5cqw, 2.25rem);
      border-radius: clamp(1rem, 4cqw, 1.75rem);
      box-shadow: inset 2px 2px 2px 4px rgba(38, 38, 38, 0.25);
    }

    h2 {
      font-size: clamp(1.5rem, 7cqw, 2.25rem);
    }

    article p {
      position: static;
      width: auto;
      font-size: clamp(0.85rem, 3.3cqw, 1rem);
      line-height: 1.5;
      text-align: left;
    }

    .view {
      position: static;
      align-self: flex-end;
      width: auto;
      height: auto;
      margin-top: 0.5rem;
      padding: 0.75em 2.5em;
      font-size: clamp(0.875rem, 3.5cqw, 1.125rem);
    }
  }
</style>
