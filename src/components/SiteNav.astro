---
import '../styles/page-transitions.css';

interface Props {
  active: 'projects' | 'photos';
  /** Brush underline beneath the active item, in Figma px from the item's top-left corner. */
  underline: { src: string; x: number; y: number; width: number };
}

const { active, underline } = Astro.props;

const items = [
  { id: 'projects', label: 'Projects', href: '/projects' },
  // Music page isn't built yet.
  { id: 'music', label: 'Music', href: undefined },
  { id: 'photos', label: 'Photos', href: '/photos' },
  { id: 'contact', label: 'Contact me', href: '/' },
];
---

<nav>
  <ul>
    {
      items.map((item) => (
        <li class:list={{ active: item.id === active, contact: item.id === 'contact' }}>
          <a href={item.href} aria-current={item.id === active ? 'page' : undefined}>
            {item.label}
          </a>
          {item.id === active && (
            <span
              class="underline"
              style={`--x: ${underline.x}; --y: ${underline.y}; --w: ${underline.width}; view-transition-name: underline-${active};`}
            >
              <img src={underline.src} alt="" />
            </span>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  ul {
    position: absolute;
    top: calc(89.06 * var(--uy));
    left: calc(97.33 * var(--ux));
    right: calc(90.74 * var(--ux));
    display: flex;
    gap: calc(163.59 * var(--ux));
    font-family: 'Unity Sans Display Max', sans-serif;
    font-size: calc(100 * var(--u));
    line-height: normal;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(0, 0, 0, 0.4);
    view-transition-name: site-nav;
  }

  li {
    position: relative;
  }

  .active {
    color: white;
  }

  .contact {
    margin-left: auto;
  }

  .underline {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    width: calc(var(--w) * var(--u));
    height: calc(32.089 * var(--u));
    pointer-events: none;
    view-transition-class: underline;
  }

  .underline img {
    position: absolute;
    top: -23.04%;
    left: 0;
    width: 100%;
    height: 140.04%;
    max-width: none;
  }

  /* Draw the brush stroke in when arriving from another section (type set in Frame.astro). */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:active-view-transition-type(section-change)) .underline img {
      animation: draw-underline 450ms cubic-bezier(0.65, 0, 0.35, 1) 300ms both;
    }
  }

  @media (max-width: 1000px), (orientation: portrait) {
    nav {
      order: -1;
    }

    ul {
      position: relative;
      inset: auto;
      flex-wrap: wrap;
      gap: 0.75em 1em;
      font-size: clamp(0.75rem, 3.2cqw, 1.5rem);
    }

    .underline {
      left: -6%;
      top: 100%;
      width: 112%;
      height: 0.32em;
    }
  }

  @keyframes draw-underline {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>

