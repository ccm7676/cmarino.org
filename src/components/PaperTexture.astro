---
import { Image, getImage } from 'astro:assets';
// paper-texture.jpg baked into black with alpha = 1 - luminance, which looks the same as
// multiplying the (greyscale) texture over the page but needs no blend mode. Chrome drops
// mix-blend-mode on the first frame of a view transition, which flashed the page white.
import paper from '../assets/paper-shade.webp';

type Props =
  | {
      x: number;
      y: number;
      width: number;
      height: number;
      /** Image placement inside the box, in percent. Omit to cover the box. */
      crop?: { left: number; top: number; width: number; height: number };
      repeat?: never;
    }
  | {
      /** Tile the texture down the whole frame, for pages taller than the design. */
      repeat: true;
    };

const props = Astro.props;

// The texture renders ~114% of the frame width on every page.
const widths = [1280, 1920, 2560, 3200, 4096];
const sizes = '114vw';

// Tiled version for the auto-height gallery, and for every page's stacked small-screen layout.
const tile = await getImage({ src: paper, width: props.repeat ? 2560 : 1280 });
---

{
  props.repeat ? (
    <div class="paper repeat" style={`--tile: url(${tile.src});`} data-preload={tile.src} />
  ) : (
    <div
      class="paper"
      style={`--x: ${props.x}; --y: ${props.y}; --w: ${props.width}; --h: ${props.height}; --tile: url(${tile.src});`}
      data-preload={tile.src}
    >
      <Image
        src={paper}
        alt=""
        widths={widths}
        sizes={sizes}
        loading="eager"
        decoding="sync"
        class={props.crop ? 'cropped' : 'cover'}
        style={props.crop &&
          `left: ${props.crop.left}%; top: ${props.crop.top}%; width: ${props.crop.width}%; height: ${props.crop.height}%;`}
      />
    </div>
  )
}

<style>
  .paper {
    position: absolute;
    left: calc(var(--x) * var(--ux));
    top: calc(var(--y) * var(--uy));
    width: calc(var(--w) * var(--ux));
    height: calc(var(--h) * var(--uy));
    overflow: hidden;
    pointer-events: none;
    view-transition-name: paper;
  }

  .repeat {
    inset: 0;
    width: auto;
    height: auto;
    /* Same scale as the covered texture on the fixed-height pages. */
    background-image: var(--tile);
    background-size: calc(4199 * var(--ux)) auto;
    background-position: center top;
    background-repeat: repeat-y;
  }

  img {
    position: absolute;
    max-width: none;
  }

  .cover {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 1000px), (orientation: portrait) {
    .paper {
      inset: 0;
      width: auto;
      height: auto;
      background-image: var(--tile);
      background-size: max(114cqw, 60rem) auto;
      background-position: center top;
      background-repeat: repeat;
    }

    img {
      display: none;
    }
  }
</style>
